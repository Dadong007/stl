---
import { SITE, absoluteUrl } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, canonicalPath, structuredData } = Astro.props;
const canonical = absoluteUrl(canonicalPath);
const schemas = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <style is:inline>
      :root {
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-synthesis: none;
      }

      h1 {
        max-width: 18ch;
        margin: 0 0 1.25rem;
        font-size: clamp(2.35rem, 6vw, 5.1rem);
        font-weight: 720;
        letter-spacing: -0.035em;
        line-height: 1.12;
      }

      .home-hero h1 {
        max-width: 16ch;
        font-size: clamp(2.35rem, 5vw, 4.2rem);
      }

      .tool-intro h1 {
        font-size: clamp(2.4rem, 6vw, 4.5rem);
      }

      @media (min-width: 801px) {
        .tool-intro h1 {
          margin-bottom: 0.85rem;
        }
      }
    </style>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="IntoSTL home">
          <span class="brand-mark" aria-hidden="true">I</span>
          <span>IntoSTL</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/image-to-stl/">Image to STL</a>
          <a href="/3mf-to-stl/">3MF to STL</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p><strong>IntoSTL</strong> — simple browser tools for printable models.</p>
        <p>Your files stay on your device.</p>
      </div>
    </footer>
  </body>
</html>
