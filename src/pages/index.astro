---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, absoluteUrl } from '../config/site';

const title = 'IntoSTL — Free STL & 3D Printing Tools';
const description = 'Free browser-based tools for converting images and 3D files to STL or 3MF. No sign-up and no uploads — your files stay on your device.';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: absoluteUrl('/'),
  description: SITE.description,
};
---

<BaseLayout title={title} description={description} canonicalPath="/" structuredData={websiteSchema}>
  <section class="home-hero shell">
    <p class="eyebrow">Free · Private · No sign-up</p>
    <h1>Turn images and 3D files into STL — right in your browser.</h1>
    <p class="hero-copy">
      Simple tools for creating printable STL files. Your files are processed locally and never uploaded.
    </p>
  </section>

  <section class="shell tool-section" aria-labelledby="available-tools">
    <div class="section-heading">
      <p class="eyebrow">Available now</p>
      <h2 id="available-tools">Choose a tool</h2>
    </div>
    <div class="tool-grid">
      <a class="tool-card" href="/image-to-stl/">
        <span class="tool-number" aria-hidden="true">01</span>
        <h3>Image to STL</h3>
        <p>Turn a JPG or PNG into a printable relief or extruded model.</p>
        <span class="text-link">Open Image to STL</span>
      </a>
      <a class="tool-card" href="/png-to-stl/">
        <span class="tool-number" aria-hidden="true">02</span>
        <h3>PNG to STL</h3>
        <p>Make a relief or extrusion from a transparent or opaque PNG.</p>
        <span class="text-link">Open PNG to STL</span>
      </a>
      <a class="tool-card" href="/3mf-to-stl/">
        <span class="tool-number" aria-hidden="true">03</span>
        <h3>3MF to STL</h3>
        <p>Convert 3MF geometry to a widely supported binary STL file.</p>
        <span class="text-link">Open 3MF to STL</span>
      </a>
      <a class="tool-card" href="/logo-to-stl/">
        <span class="tool-number" aria-hidden="true">04</span>
        <h3>Logo to STL</h3>
        <p>Extrude a PNG or JPG logo into a solid printable model.</p>
        <span class="text-link">Open Logo to STL</span>
      </a>
      <a class="tool-card" href="/jpg-to-stl/">
        <span class="tool-number" aria-hidden="true">05</span>
        <h3>JPG to STL</h3>
        <p>Turn a JPG or JPEG into a printable 3D relief.</p>
        <span class="text-link">Open JPG to STL</span>
      </a>
      <a class="tool-card" href="/stl-to-3mf/">
        <span class="tool-number" aria-hidden="true">06</span>
        <h3>STL to 3MF</h3>
        <p>Convert binary or ASCII STL geometry into a 3MF model.</p>
        <span class="text-link">Open STL to 3MF</span>
      </a>
    </div>
  </section>

  <section class="shell trust-strip" aria-label="IntoSTL principles">
    <div>
      <span class="trust-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <rect x="3.25" y="4.25" width="17.5" height="15.5" rx="2.35"></rect>
          <path d="M3.25 8.65h17.5M6.25 6.45h.01M8.55 6.45h.01m.8 8 1.75 1.7 3.7-4.15"></path>
        </svg>
      </span>
      <div class="trust-copy"><strong>Browser-local</strong><span>Files stay on your device</span></div>
    </div>
    <div>
      <span class="trust-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <circle cx="9.25" cy="7.75" r="2.85"></circle>
          <path d="M4.35 18.9c.6-3.2 2.4-4.85 4.9-4.85s4.3 1.65 4.9 4.85M16.2 11.75h4.4"></path>
        </svg>
      </span>
      <div class="trust-copy"><strong>No account</strong><span>Start converting immediately</span></div>
    </div>
    <div>
      <span class="trust-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="m12 3.35 7.4 3.8L12 11 4.6 7.15 12 3.35Zm-7.4 3.8v9.05L12 20.65l7.4-4.45V7.15M12 11v9.65"></path>
        </svg>
      </span>
      <div class="trust-copy"><strong>Printable output</strong><span>Download standard STL and 3MF files</span></div>
    </div>
  </section>
</BaseLayout>
