---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageQuickConverter from '../components/converter/HomepageQuickConverter';
import { SITE, absoluteUrl } from '../config/site';
import '../styles/home.css';

const title = 'IntoSTL — Free STL & 3D Printing Tools';
const description = 'Free browser-based tools for converting images and 3D files to STL or 3MF. No sign-up and no uploads — your files stay on your device.';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: absoluteUrl('/'),
  description: SITE.description,
};
---

<BaseLayout title={title} description={description} canonicalPath="/" structuredData={websiteSchema}>
  <section class="home-hero shell">
    <div class="home-hero-copy-block">
      <h1>Convert Images and 3D Files to STL Online</h1>
      <p class="hero-copy">
        Create printable STL files from JPG, PNG, JPEG and 3MF.<br />
        Images can become reliefs or solid extrusions.<br />
        3MF models convert directly to STL.<br />
        <span class="hero-benefits">
          <span>Free</span>
          <span>No sign-up</span>
          <span>Files stay on your device</span>
        </span>
      </p>
    </div>
    <div class="home-hero-uploader">
      <HomepageQuickConverter client:load />
    </div>
  </section>

  <section class="shell tool-section" aria-labelledby="available-tools">
    <div class="section-heading">
      <h2 id="available-tools">Choose a tool</h2>
    </div>
    <div class="tool-grid">
      <article class="tool-entry">
        <h3><a class="tool-title-link" href="/image-to-stl/">Image to STL</a></h3>
        <p>Turn a JPG or PNG into a printable relief or extruded model.</p>
      </article>
      <article class="tool-entry">
        <h3><a class="tool-title-link" href="/png-to-stl/">PNG to STL</a></h3>
        <p>Make a relief or extrusion from a transparent or opaque PNG.</p>
      </article>
      <article class="tool-entry">
        <h3><a class="tool-title-link" href="/3mf-to-stl/">3MF to STL</a></h3>
        <p>Convert 3MF geometry to a widely supported binary STL file.</p>
      </article>
      <article class="tool-entry">
        <h3><a class="tool-title-link" href="/logo-to-stl/">Logo to STL</a></h3>
        <p>Extrude a PNG or JPG logo into a solid printable model.</p>
      </article>
      <article class="tool-entry">
        <h3><a class="tool-title-link" href="/jpg-to-stl/">JPG to STL</a></h3>
        <p>Turn a JPG or JPEG into a printable 3D relief.</p>
      </article>
      <article class="tool-entry">
        <h3><a class="tool-title-link" href="/stl-to-3mf/">STL to 3MF</a></h3>
        <p>Convert binary or ASCII STL geometry into a 3MF model.</p>
      </article>
    </div>
  </section>

  <section class="home-content-section home-how-section" aria-labelledby="home-how-heading">
    <div class="shell">
      <h2 id="home-how-heading">How IntoSTL works</h2>
      <p class="home-section-intro">IntoSTL keeps file conversion simple. Start with a supported file, check the generated model in the 3D preview, and download the result when it looks right.</p>
      <ol class="home-content-grid home-steps">
        <li>
          <span class="home-step-number" aria-hidden="true">01</span>
          <h3>Choose your file</h3>
          <p>On the homepage, choose a JPG, JPEG, PNG or 3MF file. For a specific workflow, you can also open one of the dedicated tools.</p>
        </li>
        <li>
          <span class="home-step-number" aria-hidden="true">02</span>
          <h3>Preview the result</h3>
          <p>IntoSTL chooses practical defaults automatically. For image conversions, you can adjust the style, depth and size when needed.</p>
        </li>
        <li>
          <span class="home-step-number" aria-hidden="true">03</span>
          <h3>Download your model</h3>
          <p>Save the converted file directly to your device and continue working with it in your slicer or other 3D software.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="shell home-content-section home-faq-section" aria-labelledby="home-faq-heading">
    <h2 id="home-faq-heading">FAQ</h2>
    <div class="home-faq-list">
      <details>
        <summary>Are my files private?</summary>
        <p>Yes. IntoSTL processes your converter files locally in your browser. Your source images and 3D files are not uploaded to our servers for conversion, so they stay on your device.</p>
      </details>
      <details>
        <summary>Is IntoSTL free? Do I need an account?</summary>
        <p>Yes. IntoSTL is free to use, and you do not need to create an account or sign in to use the conversion tools.</p>
      </details>
      <details>
        <summary>What can I convert with IntoSTL?</summary>
        <p>IntoSTL currently supports JPG, JPEG and PNG images to STL, 3MF to STL, and STL to 3MF. Dedicated tools are also available for image, PNG, JPG and logo-to-STL workflows.</p>
      </details>
      <details>
        <summary>What is the difference between Relief and Extrude?</summary>
        <p>Relief turns image brightness into surface height, making it a good fit for photos and grayscale artwork. Extrude turns the visible shape of an image into a solid 3D form, which is usually better for logos, icons, silhouettes and transparent PNGs.</p>
      </details>
      <details>
        <summary>What information can be lost when converting 3MF to STL?</summary>
        <p>STL can preserve the final geometry, but it does not support all of the information that a 3MF file can contain. Colors, materials, textures and other metadata may be lost during conversion.</p>
      </details>
      <details>
        <summary>Can I use IntoSTL on a phone or tablet?</summary>
        <p>Yes. IntoSTL works in modern desktop and mobile browsers. A larger screen can make detailed 3D preview inspection easier, but the core conversion workflow also works on phones and tablets.</p>
      </details>
    </div>
  </section>
</BaseLayout>
