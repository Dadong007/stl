---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../config/site';

const title = 'Privacy Policy | IntoSTL';
const description = 'Learn how IntoSTL handles local file processing, website data and feedback while using its browser-based 3D printing tools.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'IntoSTL', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: absoluteUrl('/privacy/') },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath="/privacy/" structuredData={structuredData}>
  <article class="info-page">
    <header class="info-intro shell-narrow">
      <h1>Privacy Policy</h1>
      <p>This page explains how the current IntoSTL website handles converter files, website data and feedback.</p>
    </header>

    <div class="info-stack shell-narrow">
      <section aria-labelledby="privacy-files">
        <h2 id="privacy-files">File processing</h2>
        <p>Images, STL files and 3MF files selected in the converter tools are processed locally in your browser. Their contents are not uploaded to IntoSTL servers. Generated STL and 3MF files are created and downloaded through the browser.</p>
        <p>IntoSTL does not provide server-side storage for source files or generated conversion files.</p>
      </section>

      <section aria-labelledby="privacy-information">
        <h2 id="privacy-information">Information we may receive</h2>
        <p>The current site has no account system, conversion file storage or payment collection. No account is required to use the converter tools.</p>
        <p>When you submit the <a href="/contact/">Contact form</a>, IntoSTL receives the selected feedback category, your message, an optional email address and the information required to verify and deliver the request.</p>
      </section>

      <section aria-labelledby="privacy-analytics">
        <h2 id="privacy-analytics">Analytics</h2>
        <p>We use Google Analytics 4 to understand how people use IntoSTL and to improve the site. This may include information such as pages visited, referral sources, general interactions, browser and device information, approximate location, and analytics identifiers.</p>
        <p>Google Analytics may use cookies or similar technologies as part of this measurement. Google may process technical information such as IP addresses when analytics data is collected.</p>
        <p>Files you open or convert with IntoSTL are processed locally in your browser. Your images, STL files, 3MF files, and other converter file contents are not sent to Google Analytics.</p>
        <p>Analytics data is processed by Google according to the <a href="https://policies.google.com/privacy">Google Privacy Policy</a>.</p>
      </section>

      <section aria-labelledby="privacy-feedback">
        <h2 id="privacy-feedback">Contact and feedback</h2>
        <p>Information you intentionally submit through the feedback form is sent for the purpose of reviewing or responding to that feedback. If you provide an email address, it may be used to reply to your message.</p>
        <p>Converter files are not automatically attached to or sent with feedback. Do not include sensitive information in a feedback message.</p>
      </section>

      <section aria-labelledby="privacy-services">
        <h2 id="privacy-services">Third-party services</h2>
        <p>IntoSTL is hosted through Cloudflare Pages, which provides website hosting and content delivery. Cloudflare may process ordinary network request information needed to deliver the site.</p>
        <p>The Contact form uses Cloudflare Turnstile for abuse prevention and Resend for email delivery. Google Analytics is used for website usage and analytics measurement.</p>
        <p>IntoSTL does not use third-party conversion services. Converter files remain in your browser and are not sent to these services through the conversion tools.</p>
      </section>

      <section aria-labelledby="privacy-changes">
        <h2 id="privacy-changes">Changes to this policy</h2>
        <p>This page may be updated when IntoSTL functionality or data handling changes.</p>
      </section>
    </div>
  </article>
</BaseLayout>
