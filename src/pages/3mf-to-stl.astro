---
import ThreeMfConverter from '../components/converter/ThreeMfConverter';
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../config/site';

const title = '3MF to STL Converter — Free, No Upload | IntoSTL';
const description = 'Convert 3MF files to STL directly in your browser while preserving final geometry and transforms. Free, private and no upload required.';
const questions = [
  {
    question: 'Will the converted STL keep colors and materials?',
    answer: 'No. STL stores surface geometry only, so colors, materials, textures and other 3MF metadata are not included.',
  },
  {
    question: 'Does IntoSTL upload my 3MF file?',
    answer: 'No. The file is read and converted locally in your browser and is not sent to an IntoSTL server.',
  },
  {
    question: 'Why convert 3MF to STL?',
    answer: 'STL is widely supported by slicers and older 3D-printing software. Conversion can help when another tool cannot open 3MF files.',
  },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'IntoSTL 3MF to STL Converter',
    url: absoluteUrl('/3mf-to-stl/'),
    description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'IntoSTL', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: '3MF to STL', item: absoluteUrl('/3mf-to-stl/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: questions.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/3mf-to-stl/" structuredData={structuredData}>
  <article class="tool-page">
    <header class="tool-intro shell-narrow">
      <p class="eyebrow">Free browser tool</p>
      <h1>Convert 3MF to STL</h1>
      <p>Turn the final geometry in a 3MF model into a binary STL without sending the file anywhere.</p>
    </header>

    <div class="shell converter-wrap">
      <p class="privacy-note"><span aria-hidden="true">●</span> Private by design. Your files are processed locally in your browser and are not uploaded to our servers.</p>
      <ThreeMfConverter client:load />
    </div>

    <div class="shell-narrow content-stack">
      <section aria-labelledby="three-mf-how">
        <p class="eyebrow">How it works</p>
        <h2 id="three-mf-how">Convert a 3MF model in three steps</h2>
        <ol class="steps">
          <li><span>1</span><div><strong>Upload a 3MF file</strong><p>Choose a model up to 50 MB from your device.</p></div></li>
          <li><span>2</span><div><strong>Inspect the geometry</strong><p>IntoSTL combines the model's build items and transforms, then shows the STL geometry in 3D.</p></div></li>
          <li><span>3</span><div><strong>Download the STL</strong><p>Save one binary STL containing the final transformed geometry.</p></div></li>
        </ol>
      </section>

      <section class="two-column" aria-labelledby="preserved-heading">
        <div>
          <p class="eyebrow">Conversion details</p>
          <h2 id="preserved-heading">What the STL preserves</h2>
        </div>
        <div class="prose">
          <p>The converter preserves the final mesh geometry, including multiple build items and their positions. This matches what you see in the 3MF build.</p>
          <p>STL cannot carry 3MF colors, materials, textures or document metadata. Those details are intentionally omitted rather than represented inaccurately.</p>
        </div>
      </section>

      <section class="two-column" aria-labelledby="why-heading">
        <div>
          <p class="eyebrow">Compatibility</p>
          <h2 id="why-heading">Why convert 3MF to STL?</h2>
        </div>
        <div class="prose">
          <p>3MF can store richer printing information, while STL is a simpler geometry format supported by a broad range of slicers, viewers and older workflows.</p>
          <p>Use this converter when your next tool expects STL and you only need the model's surface geometry.</p>
        </div>
      </section>

      <section aria-labelledby="three-mf-faq">
        <p class="eyebrow">Common questions</p>
        <h2 id="three-mf-faq">3MF to STL FAQ</h2>
        <div class="faq-list">
          {questions.map(({ question, answer }) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <aside class="related-tool">
        <div><p class="eyebrow">Related tool</p><h2>Starting from an STL?</h2></div>
        <a class="secondary-button" href="/stl-to-3mf/">Convert STL to 3MF</a>
      </aside>
    </div>
  </article>
</BaseLayout>
