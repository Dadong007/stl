---
import StlToThreeMfConverter from '../components/converter/StlToThreeMfConverter';
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../config/site';

const title = 'STL to 3MF Converter — Free, No Upload | IntoSTL';
const description = 'Convert binary or ASCII STL files to 3MF directly in your browser. Geometry is preserved and STL units are treated as millimeters.';
const questions = [
  { question: 'Can IntoSTL read both binary and ASCII STL?', answer: 'Yes. Binary STL is supported directly, and the existing Three.js STLLoader fallback handles valid ASCII STL when required.' },
  { question: 'What units does the converter use?', answer: 'STL files do not include unit metadata, so IntoSTL treats STL units as millimeters when creating the 3MF file.' },
  { question: 'Are disconnected shells kept?', answer: 'Yes. Separate shells in the source mesh remain part of the converted 3MF geometry.' },
];
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'IntoSTL STL to 3MF Converter', url: absoluteUrl('/stl-to-3mf/'), description, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', isAccessibleForFree: true },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'IntoSTL', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'STL to 3MF', item: absoluteUrl('/stl-to-3mf/') },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: questions.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
];
---

<BaseLayout title={title} description={description} canonicalPath="/stl-to-3mf/" structuredData={structuredData}>
  <article class="tool-page">
    <header class="tool-intro shell-narrow">
      <p class="eyebrow">Free browser tool</p>
      <h1>Convert STL to 3MF</h1>
      <p>Turn a binary or ASCII STL into a 3MF model while keeping the conversion entirely on your device.</p>
    </header>
    <div class="shell converter-wrap">
      <p class="privacy-note"><span aria-hidden="true">●</span> Private by design. Your STL is processed locally in your browser.</p>
      <StlToThreeMfConverter client:load />
    </div>
    <div class="shell-narrow content-stack">
      <section aria-labelledby="stl-how">
        <p class="eyebrow">How it works</p><h2 id="stl-how">STL to 3MF in three steps</h2>
        <ol class="steps">
          <li><span>1</span><div><strong>Upload an STL</strong><p>Choose a binary or ASCII STL up to 50 MB.</p></div></li>
          <li><span>2</span><div><strong>Inspect the geometry</strong><p>Preview the parsed mesh, including disconnected shells.</p></div></li>
          <li><span>3</span><div><strong>Download the 3MF</strong><p>Save the converted model as a standard 3MF file.</p></div></li>
        </ol>
      </section>
      <section class="two-column" aria-labelledby="stl-units">
        <div><p class="eyebrow">Conversion details</p><h2 id="stl-units">Geometry and units</h2></div>
        <div class="prose"><p>The conversion carries mesh geometry into 3MF and keeps separate shells. STL files do not include unit metadata, so the source values are treated as millimeters.</p><p>3MF is useful when the next application prefers a modern container format. The new file does not invent colors, materials or print settings that were not present in the STL.</p></div>
      </section>
      <section aria-labelledby="stl-faq">
        <p class="eyebrow">Common questions</p><h2 id="stl-faq">STL to 3MF FAQ</h2>
        <div class="faq-list">{questions.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
      </section>
      <aside class="related-tool">
        <div><p class="eyebrow">Related tool</p><h2>Need STL again?</h2></div>
        <a class="secondary-button" href="/3mf-to-stl/">Convert 3MF to STL</a>
      </aside>
    </div>
  </article>
</BaseLayout>
