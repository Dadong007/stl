---
import ImageConverter from '../components/converter/ImageConverter';
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../config/site';

const title = 'Logo to STL Converter — Create Printable 3D Logos | IntoSTL';
const description = 'Turn PNG or JPG logos into extruded STL models for 3D printing. Works best with transparent or high-contrast logos and runs locally in your browser.';
const questions = [
  { question: 'Do transparent logos work best?', answer: 'Transparent PNG logos usually give the clearest result because the alpha channel defines the foreground directly.' },
  { question: 'Can holes inside a logo stay open?', answer: 'Supported holes can stay open when the artwork defines clean, closed contours, but complex details may not convert perfectly.' },
  { question: 'What happens if my logo has a solid background?', answer: 'A simple light background helps the tool identify the foreground. It does not remove or reconstruct backgrounds.' },
];
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'IntoSTL Logo to STL Converter', url: absoluteUrl('/logo-to-stl/'), description, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', isAccessibleForFree: true },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'IntoSTL', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Logo to STL', item: absoluteUrl('/logo-to-stl/') },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: questions.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
];
---

<BaseLayout title={title} description={description} canonicalPath="/logo-to-stl/" structuredData={structuredData}>
  <article class="tool-page">
    <header class="tool-intro shell-narrow">
      <p class="eyebrow">Free browser tool</p>
      <h1>Convert a Logo to STL</h1>
      <p>Turn a PNG or JPG logo into a solid, printable STL directly in your browser.</p>
    </header>
    <div class="shell converter-wrap">
      <p class="privacy-note"><span aria-hidden="true">●</span> Private by design. Your logo is processed locally in your browser.</p>
      <ImageConverter client:load defaultStyle="extrude" autoStyleFromTransparency={false} uploadPrompt="Upload a PNG or JPG logo" />
    </div>
    <div class="shell-narrow content-stack">
      <section aria-labelledby="logo-how">
        <p class="eyebrow">How it works</p><h2 id="logo-how">Logo to STL in three steps</h2>
        <ol class="steps">
          <li><span>1</span><div><strong>Choose your logo</strong><p>Upload a PNG or JPG up to 20 MB and 4096 × 4096 pixels.</p></div></li>
          <li><span>2</span><div><strong>Check the extrusion</strong><p>Adjust Depth and Size while inspecting the 3D preview.</p></div></li>
          <li><span>3</span><div><strong>Download the STL</strong><p>Save the binary STL for your slicer or modeling workflow.</p></div></li>
        </ol>
      </section>
      <section class="two-column" aria-labelledby="logo-input">
        <div><p class="eyebrow">Source artwork</p><h2 id="logo-input">Simple shapes work best</h2></div>
        <div class="prose"><p>Transparent PNG artwork uses its alpha channel. For solid-background PNG and JPG artwork, a simple light background helps separate the foreground. Supported holes and disconnected shapes are preserved, though fine isolated details may not form a practical printable model.</p></div>
      </section>
      <section aria-labelledby="logo-faq">
        <p class="eyebrow">Common questions</p><h2 id="logo-faq">Logo to STL FAQ</h2>
        <div class="faq-list">{questions.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
      </section>
      <aside class="related-tool">
        <div><p class="eyebrow">Related tools</p><h2>More image controls</h2></div>
        <div class="related-actions"><a class="secondary-button" href="/png-to-stl/">PNG to STL</a><a class="secondary-button" href="/image-to-stl/">Image to STL</a></div>
      </aside>
    </div>
  </article>
</BaseLayout>
