---
import ImageConverter from '../components/converter/ImageConverter';
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../config/site';

const title = 'Image to STL Converter — Free Online Tool | IntoSTL';
const description = 'Convert JPG or PNG images into printable STL models in your browser. Create relief or extruded models for free, with no upload or sign-up.';
const questions = [
  {
    question: 'What is the difference between Relief and Extrude?',
    answer: 'Relief uses image brightness to create a raised surface. Extrude turns a clear foreground shape into a solid model with a uniform depth.',
  },
  {
    question: 'Which images work best?',
    answer: 'Photos with clear light and dark detail work well for reliefs. Transparent PNG logos or high-contrast graphics work best for extruded models.',
  },
  {
    question: 'Are my images uploaded?',
    answer: 'No. The image is decoded and converted locally by your browser and is not sent to an IntoSTL server.',
  },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'IntoSTL Image to STL Converter',
    url: absoluteUrl('/image-to-stl/'),
    description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'IntoSTL', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Image to STL', item: absoluteUrl('/image-to-stl/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: questions.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/image-to-stl/" structuredData={structuredData}>
  <article class="tool-page">
    <header class="tool-intro shell-narrow">
      <h1>Convert an Image to STL</h1>
      <p>Upload a JPG or PNG, choose Relief or Extrude, and create a printable model directly in your browser.</p>
    </header>

    <div class="shell converter-wrap">
      <p class="privacy-note"><span aria-hidden="true">●</span> Private by design. Your files are processed locally in your browser and are not uploaded to our servers.</p>
      <ImageConverter client:load />
    </div>

    <nav class="on-this-page shell-narrow" aria-labelledby="image-page-nav">
      <p id="image-page-nav">On this page</p>
      <ul>
        <li><a href="#image-how">How to convert an image to STL</a></li>
        <li><a href="#image-styles">Relief vs Extrude</a></li>
        <li><a href="#image-printing">Best images for STL conversion</a></li>
        <li><a href="#image-faq">FAQ</a></li>
      </ul>
    </nav>

    <div class="shell-narrow content-stack">
      <section aria-labelledby="image-how">
        <h2 id="image-how">How to convert an image to STL</h2>
        <p class="section-intro">Use the image to STL converter to create either a raised relief or a solid extruded shape. The image is decoded and converted on your device, with no upload required.</p>
        <ol class="steps">
          <li><span>1</span><div><strong>Upload an image</strong><p>Choose a JPG or PNG up to 20 MB and 4096 × 4096 pixels.</p></div></li>
          <li><span>2</span><div><strong>Check the 3D preview</strong><p>Use the default Relief style or switch to Extrude, then adjust depth and size.</p></div></li>
          <li><span>3</span><div><strong>Download the STL</strong><p>Save the binary STL and open it in your slicer to choose print settings.</p></div></li>
        </ol>
      </section>

      <section class="two-column" aria-labelledby="image-styles">
        <div>
          <h2 id="image-styles">Relief vs Extrude: two ways to turn an image into STL</h2>
        </div>
        <div class="prose">
          <p><strong>Relief</strong> turns image brightness into height. It is useful for photos, maps, textured plaques and other picture-to-STL projects where shades should form the raised surface. The result includes a flat base and closed side walls.</p>
          <p><strong>Extrude</strong> turns a clearly separated foreground shape into a solid with uniform depth. Use it for simple artwork, icons or silhouettes rather than photographs. For format-specific guidance, see the <a href="/png-to-stl/">PNG converter</a> or the dedicated <a href="/logo-to-stl/">logo converter</a>.</p>
        </div>
      </section>

      <section class="two-column" aria-labelledby="image-printing">
        <div>
          <h2 id="image-printing">What images work best for 3D printing?</h2>
        </div>
        <div class="prose">
          <p>Start with a clear subject and visible tonal or shape separation. Strong contrast usually produces a more readable image relief STL, while tiny isolated marks, very thin lines and noisy backgrounds can become fragile or unclear geometry.</p>
          <p>The model keeps the image aspect ratio and is generated at a fixed internal resolution chosen for reliable browser performance. If the source is a photograph or JPEG, the <a href="/jpg-to-stl/">JPG to STL guide</a> explains how brightness becomes relief height.</p>
          <p>Before printing, inspect the downloaded STL in your slicer. Orientation, supports, layer height and printer tolerances still depend on the model and your machine.</p>
        </div>
      </section>

      <section aria-labelledby="image-faq">
        <h2 id="image-faq">Image to STL FAQ</h2>
        <div class="faq-list">
          {questions.map(({ question, answer }) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <aside class="related-tool">
        <div><p class="related-heading">Choose a focused image converter</p></div>
        <div class="related-actions">
          <a class="secondary-button" href="/png-to-stl/">PNG to STL</a>
          <a class="secondary-button" href="/jpg-to-stl/">JPG to STL</a>
          <a class="secondary-button" href="/logo-to-stl/">Logo to STL</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
